@page "/"
@inject BankApiClient Api
@implements IAsyncDisposable

<PageTitle>Валютын ханш</PageTitle>

<header class="board-header">
    <div class="board-header__brand">
        <span class="board-header__mark"></span>
        <span class="board-header__title">Валютын ханш</span>
    </div>
    <span class="board-header__live @(_isConnected ? "is-live" : "is-offline")">
        @(_isConnected ? "Connected" : "Disconnected")
    </span>
</header>

<main class="board">
    @if (_board is null)
    {
        <p class="board__loading">Ачааллаж байна...</p>
    }
    else if (_board.Count == 0)
    {
        <p class="board__loading">Одоогоор ханш бүртгэгдээгүй байна.</p>
    }
    else
    {
        <div class="rate-card">
            <table class="rate-table">
                <thead>
                    <tr>
                        <th>Валют</th>
                        <th>Авах</th>
                        <th>Зарах</th>
                        <th>Шинэчлэгдсэн</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var rate in _board.OrderedByCurrency())
                    {
                        <tr>
                            <td><span class="currency-badge">@rate.CurrencyCode</span></td>
                            <td class="rate-value">@rate.BuyRate.ToString("N2")</td>
                            <td class="rate-value">@rate.SellRate.ToString("N2")</td>
                            <td class="rate-updated">@rate.UpdatedAtUtc.ToLocalTime().ToString("g")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (!string.IsNullOrEmpty(_status))
    {
        <p class="board__status">@_status</p>
    }
</main>

@code {
    private RateBoardState? _board;
    private HubConnection? _hub;
    private string _status = string.Empty;
    private bool _isConnected;

    protected override async Task OnInitializedAsync()
    {
        var rates = await Api.GetRatesAsync();
        var board = new RateBoardState();
        board.ReplaceAll(rates);
        _board = board;

        _hub = new HubConnectionBuilder()
            .WithUrl(ApiConfig.BaseUrl + HubRoutes.Rates)
            .WithAutomaticReconnect()
            .Build();

        // Pushed the instant any teller changes a rate -- this is what makes the board
        // update live instead of someone having to refresh the page. Same idea as
        // Control.Invoke in the WinForms apps: the callback runs on a background thread,
        // so StateHasChanged has to be marshalled back via InvokeAsync.
        _hub.On<ExchangeRateDto>(nameof(IRatesClient.RateChanged), rate =>
        {
            board.Upsert(rate);
            InvokeAsync(StateHasChanged);
        });

        _hub.Reconnecting += _ => { _isConnected = false; return InvokeAsync(StateHasChanged); };
        _hub.Reconnected += _ => { _isConnected = true; return InvokeAsync(StateHasChanged); };
        _hub.Closed += _ => { _isConnected = false; return InvokeAsync(StateHasChanged); };

        try
        {
            await _hub.StartAsync();
            _isConnected = true;
        }
        catch (Exception ex)
        {
            _status = $"Сервертэй холбогдож чадсангүй: {ex.Message}";
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_hub is not null)
        {
            await _hub.DisposeAsync();
        }
    }
}
